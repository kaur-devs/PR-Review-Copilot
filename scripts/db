#!/usr/bin/env bash
# A short way to open the database with psql.
#
#   scripts/db                 open it
#   scripts/db tables          list its tables
#   scripts/db "SELECT 1"      run one statement
#
# The URL carries "+asyncpg", a Python driver detail psql does not
# understand, so it is stripped here.

set -euo pipefail
cd "$(dirname "$0")/.."

url=$(grep '^DATABASE_URL=' .env | cut -d= -f2- | sed 's|+asyncpg||')

case "${1:-}" in
  "")     exec psql "$url" ;;
  tables) exec psql "$url" -c '\dt' ;;
  *)      exec psql "$url" -c "$1" ;;
esac
