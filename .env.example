# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# From the App's settings page. The secret is one you invent and paste into
# the webhook secret field there; generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pr_review_copilot
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pr_review_copilot_test

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# Any OpenAI-compatible provider works; only these three change when swapping.
# Groq's free tier gives 14,400 requests a day with no card:
#   https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# A different model checks the findings, because a model asked to check
# its own work mostly agrees with itself. Set JUDGE_ENABLED=0 to skip it.
LLM_JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_ENABLED=1

# Prints a full structured trace of each review to the terminal.
# Set to 0 for quiet, production-style logging.
PIPELINE_TRACE=1

# ---------------------------------------------------------------------------
# Feature switches
# ---------------------------------------------------------------------------
# The agentic pipeline (LangGraph, two specialists, a tool-using verifier)
# instead of the single-pass one. 0 = the old pipeline.
AGENTIC_PIPELINE=0

# Connected-code context from the repository snapshot. 0 = diff only.
CONTEXT_ENABLED=1

# Replacement lines offered alongside comments.
SUGGESTIONS_ENABLED=1

# Per-kind generation prompts. 0 = one broad prompt. Used by the ablations.
TEMPLATES_ENABLED=1

# Pick up reviews interrupted by a restart.
RECOVERY_ON_STARTUP=1
