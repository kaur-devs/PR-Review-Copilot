# Copy to .env and fill in real values. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# From the App's settings page. The secret is one you invent and paste into
# the webhook secret field there; generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pr_review_copilot
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pr_review_copilot_test

# Production. Paste the provider's string unedited — src/db/url.py rewrites the
# scheme and converts sslmode for our driver. On Render this becomes DATABASE_URL.
NEON_DATABASE_URL=

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# Any OpenAI-compatible provider works; only these three change when swapping.
# Groq's free tier gives 14,400 requests a day with no card:
#   https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
